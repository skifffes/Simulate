    "scene": "src/exp41/scene41.py",
    "evaluator": "src/exp41/strict_eval.py (exp4.1-strict-v1.2)",
    "split": "results/experiment_4_1/dataset/split_manifest.json",
    "camera": "exp40-camera-v3"
  },
  "split_constraints": {
    "A90_train_goals": ["A_x-3_y-3", "A_x00_y-3", "A_x+3_y-3",
                        "A_x-3_y00", "A_x00_y00", "A_x+3_y00"],
    "A90_val_goals": ["A_x-3_y+3", "A_x00_y+3"],
    "A90_test_goals": ["A_x+3_y+3"],
    "B90_train_configs": ["B_wall_y_low|B_obj_y015|B_robot_home",
                          "B_wall_y_low|B_obj_y015|B_robot_offset",
                          "B_wall_y_mid|B_obj_y021|B_robot_home",
                          "B_wall_y_mid|B_obj_y021|B_robot_offset"],
    "B90_val_configs": ["B_wall_y_high|B_obj_y027|B_robot_home"],
    "B90_test_configs": ["B_wall_y_high|B_obj_y027|B_robot_offset"],
    "rule": "新增数据只使用 train goals/configs；val/test 的 3 个条件完全未使用"
  },
  "seed_policy": {
    "original": "A90: 410000 + gi*100 + k (k<12); B90: 420000 + gi*100 + k (k<12)",
