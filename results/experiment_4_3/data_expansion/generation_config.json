    "duplicate_guard": "compile_results.py 统计唯一 seed 数并与 episode 数比对"
  },
  "collection": {
    "le_lerobot_writer": "LeRobot v2.1，20 Hz，240 Hz 物理，12 physics steps/action",
    "only_strict_success_stored": true,
    "failed_attempts": "仅写入 records/ 供审计，不进入 dataset",
    "parallelism": "4 进程（A90×2、B90×2），各自独立 out/data 目录与 seed 区间"
  },
  "targets": {"A90_new": 70, "B90_new": 69, "final_train": {"A90": 100, "B90": 100}}
