{
  "experiment": "4.3_data_expansion",
  "date": "2026-11-05",
  "base_commit": "6f72bc5",
  "goal": "每个原子技能达到 100 条 train split 独立严格成功示范（A90 新增 70、B90 新增 69）",
  "source_of_truth": {
    "collector": "scripts/exp41/collect41.py",
